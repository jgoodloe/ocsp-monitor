# Copy to .env and adjust as needed: cp .env.example .env

# URL subpath if served behind a reverse proxy at a path (e.g. /ocsp).
# Leave empty when the app has its own (sub)domain or is served at root.
URL_PREFIX=

# How often (seconds) the scheduler looks for responders due to be checked.
SCHEDULER_INTERVAL=30

# Per-request OCSP HTTP timeout (seconds).
OCSP_TIMEOUT=30

# Number of status-history rows retained per responder.
HISTORY_LIMIT=200

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===========================================================================
# Authentication (OIDC SSO + local login)
# ===========================================================================
# The app is FAIL-CLOSED: if none of the variables below are set it refuses to
# start, unless you explicitly opt into running with NO authentication:
#
#   OCSPMON_ALLOW_OPEN_MODE=true
#
# Only do that on an isolated single-user/dev box. On anything network-reachable,
# configure authentication instead. See docs/AUTH.md for the full guide.

# --- Session cookie (required once auth is on) ---
# Signs the session cookie. Generate once and keep stable: openssl rand -hex 32
OCSPMON_SESSION_SECRET=
# Session lifetime (seconds). Default 28800 = 8 hours.
OCSPMON_SESSION_TTL_SECONDS=28800
# Set to false ONLY for local http testing. Leave true in production (HTTPS).
OCSPMON_SESSION_COOKIE_SECURE=true

# --- Break-glass local admin (recommended: create the first user) ---
# On startup this account is created (or its password reset). Use it to sign in
# before OIDC is wired, and as a recovery path if the IdP is unavailable.
OCSPMON_BOOTSTRAP_ADMIN_USERNAME=admin
OCSPMON_BOOTSTRAP_ADMIN_PASSWORD=
# Set to false to disable the local username/password form entirely (SSO-only).
# The break-glass admin above still works for recovery.
OCSPMON_LOCAL_LOGIN_ENABLED=true

# --- OIDC / SSO (authentik). All three are required to enable SSO. ---
# Issuer is the authentik application's OpenID endpoint (note the trailing slash):
#   https://<authentik-host>/application/o/<app-slug>/
OCSPMON_OIDC_ISSUER=
OCSPMON_OIDC_CLIENT_ID=
OCSPMON_OIDC_CLIENT_SECRET=
OCSPMON_OIDC_SCOPES=openid email profile
# Claim that lists the user's groups (authentik's default profile scope emits names).
OCSPMON_OIDC_GROUP_CLAIM=groups
# Optional: restrict sign-in to members of these IdP groups (comma-separated).
# Leave empty to let ANY authenticated IdP user in.
OCSPMON_OIDC_ALLOWED_GROUPS=
# External base URL, used to build the OIDC redirect URI when the app can't infer
# it from forwarded headers. Set it to your public origin, no trailing slash:
#   https://ocspmonitor.goodloe.xyz
OCSPMON_PUBLIC_BASE_URL=
